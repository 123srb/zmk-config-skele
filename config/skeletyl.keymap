#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// The default keymap is roughly on Miryoku layout
// (https://github.com/manna-harbour/miryoku).
// Customize on your own on the config folder.

#define BASE    0
#define NAV     1
#define SYM     2
#define NUM     3
#define FUN     4
#define MOUSE   5

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";

            hold-while-undecided;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp Q       &kp W       &kp E       &kp R       &kp T                                   &kp Y           &kp U       &kp I       &kp O           &kp P
    &hm LGUI A  &hm LALT S  &hm LSHFT D &hm LCTRL F &kp G                                   &kp H           &hm LCTRL J &hm LSHFT K &hm LALT L      &hm LGUI SQT
    &kp Z       &hm RALT X  &kp C       &kp V       &kp B                                   &kp N           &kp M       &kp COMMA   &hm RALT DOT    &kp FSLH
                                        &kp BSPC       &lt MOUSE TAB  &lt NAV DEL  &lt SYM ESC   &lt NUM RET     &lt FUN SPACE
            >;
        };

        nav_layer {
            bindings = <
    &none       &none       &none       &none       &none                           &kp LC(Y)    &kp LC(C)   &kp UP      &kp LC(V)   &kp LC(Z)
    &kp LSHFT   &kp LALT    &kp LSHFT   &kp LCTRL   &none                           &kp CAPS    &kp LEFT    &kp DOWN    &kp RIGHT   &kp LC(X)
    &none       &none       &none       &none       &none                           &kp INS     &kp HOME    &kp PG_DN   &kp PG_UP   &kp END
                                        &none       &trans  &none       &kp RET     &kp BSPC    &kp DEL     
            >;
        };

        sym_layer {
            bindings = <
    &kp LBRC    &kp AMPS    &kp STAR    &kp CARET  &kp RBRC                     &none       &none       &none       &none       &none
    &kp COLON   &kp DLLR    &kp PRCNT   &kp MINUS  &kp PLUS                     &none       &kp RCTRL   &kp RSHFT   &kp RALT    &kp RGUI
    &kp TILDE   &kp EXCL    &kp AT      &kp HASH   &kp PIPE                     &none       &none       &none       &none       &none
                                        &kp LPAR   &kp RPAR &kp UNDER   &trans  &none       &none
            >;
        };

        num_layer {
            bindings = <
    &kp LBKT    &kp N7  &kp N8  &kp N9  &kp RBKT                        &none   &none       &none       &none       &none
    &kp SEMI    &kp N4  &kp N5  &kp N6  &kp EQUAL                       &none   &kp RCTRL   &kp RSHFT   &kp RALT    &kp RGUI
    &kp GRAVE   &kp N1  &kp N2  &kp N3  &kp BSLH                        &none   &none       &none       &none       &none
                                &kp DOT &kp N0      &kp MINUS   &none   &trans  &none
            >;
        };

        fun_layer {
            bindings = <
    &kp F12 &kp F7  &kp F8  &kp F9      &kp PSCRN                           &none   &none       &none       &none       &none
    &kp F11 &kp F4  &kp F5  &kp F6      &kp SLCK                            &none   &kp RCTRL   &kp RSHFT   &kp RALT    &kp RGUI
    &kp F10 &kp F1  &kp F2  &kp F3      &kp PAUSE_BREAK                     &none   &none       &none       &none       &none
                            &kp K_APP   &kp SPACE       &kp TAB     &none   &none   &trans
            >;
        };

        mouse_layer {
            bindings = <
    &none       &none       &none       &none       &none                           &msc SCRL_UP    &none           &mmv MOVE_UP    &none           &none
    &kp LSHFT   &kp LALT    &kp LSHFT   &kp LCTRL   &none                           &msc SCRL_DOWN  &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT &none
    &none       &none       &none       &none       &none                           &none           &none           &none           &none           &none
                                        &trans      &none   &none       &mkp LCLK   &mkp MCLK       &mkp RCLK
            >;
        };
    };
};